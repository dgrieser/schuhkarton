# Face detection for Schuhkarton: "schuhkarton worker" with Python, OpenCV and
# the YuNet/SFace models. The gallery itself is one binary and needs none of this.
#
#   docker build -f Dockerfile.faces -t schuhkarton-faces .
#   docker run -p 8089:8089 -e SCHUHKARTON_WORKER_TOKEN=geheim schuhkarton-faces

FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS build
ARG TARGETOS TARGETARCH TARGETVARIANT VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN GOARM=${TARGETVARIANT#v} CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X github.com/dgrieser/schuhkarton/internal/version.Version=${VERSION}" \
    -o /out/schuhkarton ./cmd/schuhkarton

FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir opencv-python-headless==4.10.0.84 pillow==11.0.0 pillow-heif==0.20.0 "numpy<2.2" \
 && useradd --system --home /tmp --uid 10001 schuhkarton \
 && mkdir -m 0755 /models
ADD --chmod=644 --checksum=sha256:8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4 \
    https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx /models/
ADD --chmod=644 --checksum=sha256:0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79 \
    https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx /models/
COPY --from=build /out/schuhkarton /usr/local/bin/schuhkarton
USER schuhkarton
ENV SCHUHKARTON_WORKER_LISTEN=0.0.0.0:8089 SCHUHKARTON_FACES_MODELS_DIR=/models SCHUHKARTON_FACES_PYTHON=/usr/local/bin/python
EXPOSE 8089
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8089/healthz')" || exit 1
ENTRYPOINT ["schuhkarton", "worker"]
